root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 120
ktlint_function_naming_ignore_when_annotated_with = Composable
# The code base uses Kotlin's official trailing-comma style, not the Android Studio default.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[**/ui/note/PenWheel*.kt]
# Formatted in a follow-up once the pen wheel work lands.
ktlint_standard = disabled
ktlint_experimental = disabled

[**/ui/theme/GraphoTokens.kt]
# Generated by design/tokens/build-kotlin.mjs, so its layout is the generator's.
ktlint_standard = disabled
ktlint_experimental = disabled
